{
  "name": "agrihub-field-command",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run backend:dev\" \"npm run frontend:dev\"",
    "frontend:dev": "vite",
    "backend:dev": "node --watch backend/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently --kill-others \"npm run backend:dev\" \"vite\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "vite build && electron-packager . \"AgriHub Field Command\" --platform=win32 --arch=x64 --icon=public/favicon.png --out=dist_electron --overwrite --ignore=\"^/node_modules\" --ignore=\"^/src\" --ignore=\"^/android\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@electron/packager": "^18.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "html5-qrcode": "^2.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "vite": "^5.3.1",
    "wait-on": "^9.0.10"
  }
}
